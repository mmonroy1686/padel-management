# Local: copy API_URL and PUBLISHABLE_KEY (or ANON_KEY) from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Overrides the public URL used in email links and OAuth redirects.
# NEXT_PUBLIC_SITE_URL=

# Multi-club: each club on <slug>.<NEXT_PUBLIC_ROOT_DOMAIN>. Without the root domain (local, previews), every host that is
# not <slug>.localhost shows DEFAULT_CLUB_SLUG's club.
# NEXT_PUBLIC_ROOT_DOMAIN=
# DEFAULT_CLUB_SLUG=rustic

# Lista de espera: avisos por mail. Without these the waitlist still works, with the avisos in the app.
# Service role (server only, never NEXT_PUBLIC_): the outbox reads the players' addresses with it.
# Local: SERVICE_ROLE_KEY (or SECRET_KEY) from `supabase status -o env`.
# SUPABASE_SERVICE_ROLE_KEY=
# Resend: an API key and a sender on a domain verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM="Rustic Pádel <avisos@example.com>"
# Shared secret for the external cron that calls POST /api/avisos/enviar every minute with
# "Authorization: Bearer <NOTIFY_SECRET>". Use a long random string (openssl rand -hex 32).
# NOTIFY_SECRET=

# Product name for the legal pages (/terminos, /privacidad), still undecided. Without it they show a gap to fill.
# NEXT_PUBLIC_PRODUCT_NAME=

# Club map tiles (README, «Mapa del club»). Without them, OpenStreetMap's public servers: fine for development and
# the pilot. Put a provider with a key before adding more clubs.
# NEXT_PUBLIC_MAP_TILES_URL=https://.../{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="...">Provider</a>

# Error monitoring. Without the DSN nothing is sent (local, CI and e2e run without it).
# NEXT_PUBLIC_SENTRY_DSN=
# Optional, build time only (Vercel): upload source maps for readable stacks.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# The host /plataforma opens on (the platform admin's panel): the Vercel production URL today, the root domain later.
# Anywhere else it is a 404. npm run dev:local and the e2e use localhost:3000.
# PLATFORM_HOST=padel-management-one.vercel.app
